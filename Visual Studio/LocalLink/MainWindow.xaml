<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LocalLink.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalLink"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LocalLink">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="RootNavigationView"
                    FontFamily="Segoe UI Variable"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    OpenPaneLength="140"
                    SelectionChanged="MainNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            
            <NavigationViewItem x:Name="MemoNavItem"
                                Content="Memo"
                                IsSelected="True"
                                Tag="memo">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F1;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Weather"
                                Tag="location">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE753;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="Cameras"
                                Tag="cameras">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE714;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem x:Name="Ws2812NavItem"
                                Content="Lightboard"
                                Tag="ws2812"
                                Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xF261;"
                              RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="90"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SettingsNavItem"
                                Content="Settings"
                                Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <ScrollViewer x:Name="RootScrollViewer">
            <Grid Padding="20"
                  RowSpacing="18"
                  HorizontalAlignment="Stretch"
                  RequestedTheme="Default">
                <StackPanel x:Name="StatusPage"
                            Spacing="18"
                            Visibility="Collapsed">
                    <TextBlock Text="Status"
                               FontSize="28"
                               FontWeight="SemiBold" />

                    <Border Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Location" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CityTextBlock" Text="City:" />
                                    <TextBlock x:Name="StateTextBlock" Text="State:" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Weather" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WeatherTextBlock" Text="Weather:" />
                                    <TextBlock x:Name="TemperatureTextBlock" Text="Temperature:" />
                                    <TextBlock x:Name="HumidityTextBlock" Text="Humidity:" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="SettingsPage"
                            Spacing="18"
                            Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8D7;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Token"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE753;" FontSize="16" />
                                <TextBlock Text="OpenWeather"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="OpenWeatherKeyBox"
                                     Grid.Column="1"
                                     TextChanged="TokenBox_TextChanged" />

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button x:Name="SetTokensButton"
                                        Content="Set Token"
                                        Click="SetTokensButton_Click"
                                        IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE771;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Appearance"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE771;" FontSize="16" />
                                <TextBlock Text="Theme"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox x:Name="WindowsThemeComboBox"
                                      Grid.Column="1"
                                      Width="160"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="WindowsThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Auto" Tag="auto" />
                                <ComboBoxItem Content="Light" Tag="light" />
                                <ComboBoxItem Content="Dark" Tag="dark" />
                            </ComboBox>

                            <Grid x:Name="AutoThemeOptionsPanel"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Width="360"
                                  HorizontalAlignment="Left"
                                  RowSpacing="8"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="OpenWeather"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="AutoThemeOpenWeatherToggle"
                                                  Grid.Column="1"
                                                  MinWidth="96"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  Toggled="AutoThemeSourceToggle_Toggled" />
                                </Grid>

                                <Grid x:Name="EspLightSensorSourceRow"
                                      Grid.Row="1"
                                      ColumnSpacing="8"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="ESP light sensor" />
                                        <TextBlock x:Name="EspLuxValueTextBlock"
                                                   Text="-- lux"
                                                   Opacity="0.65" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoThemeEspToggle"
                                                  Grid.Column="1"
                                                  MinWidth="96"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  Toggled="AutoThemeSourceToggle_Toggled" />
                                </Grid>

                                <Border x:Name="EspLuxThresholdPanel"
                                        Grid.Row="2"
                                        Margin="16,2,0,4"
                                        Padding="14,8,0,8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="2,0,0,0"
                                        Visibility="Collapsed">
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Dark below"
                                                   VerticalAlignment="Center" />
                                        <NumberBox x:Name="DarkBelowLuxNumberBox"
                                                   Grid.Column="1"
                                                   Minimum="0"
                                                   SmallChange="1"
                                                   LargeChange="10"
                                                   PlaceholderText="lux"
                                                   SpinButtonPlacementMode="Hidden"
                                                   ValueChanged="LuxThresholdNumberBox_ValueChanged" />

                                        <TextBlock Grid.Row="1"
                                                   Text="Light above"
                                                   VerticalAlignment="Center" />
                                        <NumberBox x:Name="LightAboveLuxNumberBox"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Minimum="0"
                                                   SmallChange="1"
                                                   LargeChange="10"
                                                   PlaceholderText="lux"
                                                   SpinButtonPlacementMode="Hidden"
                                                   ValueChanged="LuxThresholdNumberBox_ValueChanged" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xECC6;" FontSize="16" />
                                <TextBlock Text="Unit"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox x:Name="WeatherUnitsComboBox"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Width="160"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="WeatherUnitsComboBox_SelectionChanged">
                                <ComboBoxItem Content="Celsius" Tag="metric" />
                                <ComboBoxItem Content="Fahrenheit" Tag="imperial" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="System"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC4A;" FontSize="16" />
                                <TextBlock Text="Start Up"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggleSwitch"
                                          Grid.Column="1"
                                          HorizontalAlignment="Left"
                                          OnContent="On"
                                          OffContent="Off"
                                          Toggled="StartupToggleSwitch_Toggled" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE787;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Calendar"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B5;" FontSize="16" />
                                <TextBlock Text="Import"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Content="Import .ics"
                                        Click="ImportIcsButton_Click" />
                                <Button Content="Import .txt"
                                        Click="ImportTxtButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Ws2812Page"
                            Spacing="18"
                            Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xF261;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <TextBlock Text="Lightboard"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Border Height="230"
                                    Padding="8"
                                    CornerRadius="12"
                                    Background="#FF050505">
                                <Canvas x:Name="Ws2812PreviewCanvas"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        SizeChanged="Ws2812PreviewCanvas_SizeChanged" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Display Content"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE7F4;"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Mode"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  ColumnSpacing="8"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="Ws2812ContentModeComboBox"
                                          HorizontalAlignment="Stretch"
                                          Header="Display mode"
                                          SelectionChanged="Ws2812ContentModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Fixed" Tag="fixed" />
                                    <ComboBoxItem Content="Scrolling" Tag="scrolling" />
                                </ComboBox>

                                <Grid x:Name="Ws2812ContentSwitchPanel"
                                      Grid.Column="1"
                                      Visibility="Collapsed">
                                    <ComboBox x:Name="Ws2812ContentSwitchSecondsComboBox"
                                              HorizontalAlignment="Stretch"
                                              Header="Switch every"
                                              SelectionChanged="Ws2812ContentSwitchSecondsComboBox_SelectionChanged">
                                        <ComboBoxItem Content="3 seconds" Tag="3" />
                                        <ComboBoxItem Content="5 seconds" Tag="5" />
                                        <ComboBoxItem Content="10 seconds" Tag="10" />
                                        <ComboBoxItem Content="15 seconds" Tag="15" />
                                        <ComboBoxItem Content="30 seconds" Tag="30" />
                                        <ComboBoxItem Content="1 minute" Tag="60" />
                                    </ComboBox>
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                <TextBlock Text="Content"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ComboBox x:Name="Ws2812FixedContentComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Width="200"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="Ws2812FixedContentComboBox_SelectionChanged">
                                <ComboBoxItem Content="Time" Tag="time" />
                                <ComboBoxItem Content="Weather" Tag="weather" />
                            </ComboBox>

                            <StackPanel x:Name="Ws2812ScrollingContentPanel"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Visibility="Collapsed">
                                <CheckBox x:Name="Ws2812TimeCheckBox"
                                          Content="Time"
                                          Click="Ws2812DisplayContentCheckBox_Click" />
                                <CheckBox x:Name="Ws2812WeatherCheckBox"
                                          Content="Weather"
                                          Click="Ws2812DisplayContentCheckBox_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE823;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Timer"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE916;"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Countdown"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="1 hour" Tag="3600" Click="Ws2812TimerPresetButton_Click" />
                                <Button Content="30 min" Tag="1800" Click="Ws2812TimerPresetButton_Click" />
                                <Button Content="5 min" Tag="300" Click="Ws2812TimerPresetButton_Click" />
                                <Button Content="1 min" Tag="60" Click="Ws2812TimerPresetButton_Click" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="Ws2812TimerHoursComboBox"
                                          Header="Hours"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Ws2812TimerDurationComboBox_SelectionChanged" />
                                <ComboBox x:Name="Ws2812TimerMinutesComboBox"
                                          Grid.Column="1"
                                          Header="Minutes"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Ws2812TimerDurationComboBox_SelectionChanged" />
                                <ComboBox x:Name="Ws2812TimerSecondsComboBox"
                                          Grid.Column="2"
                                          Header="Seconds"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Ws2812TimerDurationComboBox_SelectionChanged" />
                                <Button Grid.Column="3"
                                        VerticalAlignment="Bottom"
                                        Content="Start"
                                        Click="Ws2812TimerStartButton_Click" />
                            </Grid>

                            <Grid x:Name="Ws2812TimerRunningPanel"
                                  Visibility="Collapsed">
                                <TextBlock x:Name="Ws2812TimerRemainingTextBlock"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button x:Name="Ws2812TimerPauseButton"
                                            Content="Pause"
                                            Click="Ws2812TimerPauseButton_Click" />
                                    <Button Content="Cancel"
                                            Click="Ws2812TimerCancelButton_Click" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid x:Name="MemoPage"
                      RowSpacing="18"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <DataTemplate x:Key="MemoCalendarItemTemplate">
                            <Grid ColumnSpacing="4"
                                  Padding="2,0"
                                  Tag="{Binding}"
                                  Tapped="MemoCalendarItem_Tapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Text}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Width="18"
                                        Height="18"
                                        MinWidth="18"
                                        MinHeight="18"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Tag="{Binding Id}"
                                        Click="DeleteCalendarMemoButton_Click">
                                    <FontIcon Glyph="&#xE711;"
                                              FontSize="10" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </Grid.Resources>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="10">
                        <FontIcon Glyph="&#xE787;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Calendar"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Border x:Name="MemoCalendarRegion"
                            Grid.Row="1"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="8"
                            DragLeave="MemoCalendarRegion_DragLeave"
                            AllowDrop="True">

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="MemoMonthNavigationView"
                                  RowSpacing="4"
                                  DragLeave="MemoMonthNavigationView_DragLeave"
                                  DragOver="MemoMonthNavigationView_DragOver"
                                  Drop="MemoMonthNavigation_DragFinished"
                                  Loaded="MemoMonthNavigationView_Loaded"
                                  SizeChanged="MemoMonthNavigationView_SizeChanged"
                                  AllowDrop="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Button x:Name="MemoMonthNavItem1" Grid.Row="0" Tag="1" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem2" Grid.Row="1" Tag="2" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem3" Grid.Row="2" Tag="3" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem4" Grid.Row="3" Tag="4" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem5" Grid.Row="4" Tag="5" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem6" Grid.Row="5" Tag="6" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem7" Grid.Row="6" Tag="7" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem8" Grid.Row="7" Tag="8" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem9" Grid.Row="8" Tag="9" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem10" Grid.Row="9" Tag="10" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem11" Grid.Row="10" Tag="11" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                                <Button x:Name="MemoMonthNavItem12" Grid.Row="11" Tag="12" AllowDrop="True" Click="MemoMonthNavigationItem_Click" DragEnter="MemoMonthNavigationItem_DragOver" DragOver="MemoMonthNavigationItem_DragOver" DragLeave="MemoMonthNavigationItem_DragLeave" Drop="MemoMonthNavigation_DragFinished" />
                            </Grid>

                            <Grid x:Name="MemoCalendarGrid"
                                  Grid.Column="1"
                                  ColumnSpacing="8"
                                  RowSpacing="8" />
                        </Grid>
                    </Border>

                </Grid>

                <Grid x:Name="LocationPage"
                      RowSpacing="18"
                      VerticalAlignment="Stretch"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE753;" FontSize="22" Margin="0,5,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Weather" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Height="170"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                            <TextBlock x:Name="MemoCityTextBlock" FontSize="18" Visibility="Collapsed" />
                            <TextBlock x:Name="LocationSeparatorTextBlock" Text="," FontSize="18" Visibility="Collapsed" />
                            <TextBlock x:Name="MemoStateTextBlock" FontSize="18" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock x:Name="CurrentWeatherSymbolTextBlock"
                                       Text="☀"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="56"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="MemoTemperatureTextBlock"
                                       FontSize="60"
                                       FontWeight="Light"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="MemoWeatherTextBlock"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="MemoHumidityTextBlock"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE787;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Daily"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Row="3"
                            Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid MinHeight="136">
                            <ProgressRing x:Name="DailyForecastProgressRing"
                                          Width="32" Height="32" IsActive="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="DailyForecastStatusTextBlock"
                                       Text="Daily forecast unavailable"
                                       Opacity="0.65"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid x:Name="DailyForecastPanel"
                                  ColumnSpacing="8"
                                  HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE823;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Hourly"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Row="5"
                            Padding="8"
                            MinHeight="250"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid VerticalAlignment="Stretch">
                            <ProgressRing x:Name="HourlyForecastProgressRing"
                                          Width="32" Height="32" IsActive="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="HourlyForecastStatusTextBlock"
                                       Text="Hourly forecast unavailable"
                                       Opacity="0.65"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Canvas x:Name="HourlyForecastCanvas"
                                    Background="Transparent"
                                    Visibility="Collapsed"
                                    Loaded="HourlyForecastCanvas_Loaded"
                                    SizeChanged="HourlyForecastCanvas_SizeChanged"
                                    PointerMoved="HourlyForecastCanvas_PointerMoved"
                                    PointerExited="HourlyForecastCanvas_PointerExited" />
                        </Grid>
                    </Border>

                </Grid>

                <Grid x:Name="CamerasPage"
                      RowSpacing="18"
                      Visibility="Collapsed"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="10">
                        <FontIcon Glyph="&#xE714;"
                                  FontSize="22"
                                  Margin="0,5,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Cameras"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Button x:Name="ScanCameraButton"
                                    Content="Scan"
                                    Click="ScanCameraButton_Click" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="CameraPreviewContainerBorder"
                            Grid.Row="2"
                            Padding="8"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Grid x:Name="CameraPreviewGrid"
ColumnSpacing="8"
                              RowSpacing="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Window>
